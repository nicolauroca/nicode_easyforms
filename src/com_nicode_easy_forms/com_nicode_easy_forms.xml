<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
  <name>com_nicode_easy_forms</name>
  <version>1.0.0</version>
  <author>Nicode</author>
  <creationDate>2026-09</creationDate>
  <license>GPL-2.0-or-later</license>
  <description>Nicode EasyForms — development build, acceptance incomplete</description>
  <namespace path="src">Nicode\Component\EasyForms</namespace>
  <scriptfile>script.php</scriptfile>
  <install><sql>
    <file driver="mysql" charset="utf8">sql/mysql/install.sql</file>
    <file driver="postgresql" charset="utf8">sql/postgresql/install.sql</file>
  </sql></install>
  <update><schemas>
    <schemapath type="mysql">sql/mysql/updates</schemapath>
    <schemapath type="postgresql">sql/postgresql/updates</schemapath>
  </schemas></update>
  <files folder="site"><folder>src</folder><folder>tmpl</folder><folder>language</folder></files>
  <languages folder="site">
    <language tag="en-GB">language/en-GB/com_nicode_easy_forms.ini</language>
    <language tag="es-ES">language/es-ES/com_nicode_easy_forms.ini</language>
  </languages>
  <media destination="com_nicode_easy_forms" folder="media"><filename>joomla.asset.json</filename><folder>js</folder><folder>css</folder></media>
  <administration>
    <menu>Nicode EasyForms</menu>
    <files folder="administrator"><filename>purgeguard.php</filename><filename>access.xml</filename><filename>config.xml</filename><folder>services</folder><folder>src</folder><folder>sql</folder><folder>tmpl</folder><folder>language</folder></files>
    <languages folder="administrator">
      <language tag="en-GB">language/en-GB/com_nicode_easy_forms.sys.ini</language>
      <language tag="es-ES">language/es-ES/com_nicode_easy_forms.sys.ini</language>
      <language tag="en-GB">language/en-GB/com_nicode_easy_forms.ini</language>
      <language tag="es-ES">language/es-ES/com_nicode_easy_forms.ini</language>
    </languages>
  </administration>
</extension>
